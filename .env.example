# Copy to .env and fill in. Never commit .env.
PORT=3000
APP_URL=http://localhost:3000

# Random string used to sign session cookies. Generate: openssl rand -hex 32
COOKIE_SECRET=change-me-to-a-random-string

# Spotify (PKCE public client — no client secret needed)
SPOTIFY_CLIENT_ID=d5baa23332d64e198419d95d2272be2e
SPOTIFY_REDIRECT_URI=http://localhost:3000/auth/callback

# Stripe (Radar Pro = $1/month). Leave empty to disable billing.
STRIPE_SECRET_KEY=
STRIPE_PRICE_ID=
STRIPE_WEBHOOK_SECRET=

# Shared secret protecting GET /api/cron/check-milestones
CRON_SECRET=change-me-to-a-random-string

# SQLite file location
DATABASE_PATH=./data/taste-radar.db
